    <model name="inner_r_1"><static>true</static><pose>7.5 0 1 0 0 1.57</pose><link name="l"><collision name="c"><geometry><box><size>5 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>5 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    
    <model name="pillar_sample"><static>true</static><pose>4 8 0 0 0 0</pose><link name="l">
      <collision name="c"><pose>0 0 1 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry></collision>
      <visual name="v"><pose>0 0 1 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry><material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material></visual>
      <collision name="b"><pose>0 0 0.075 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry></collision>
      <visual name="bv"><pose>0 0 0.075 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
