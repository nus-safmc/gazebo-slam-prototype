<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- PX4-friendly competition arena: no embedded rex_quadcopter models. -->
  <!-- Drones are spawned dynamically by PX4 SITL via px4_swarm_fast.launch.py -->
  <world name="playfield">
    <!-- Finer physics step (2ms) for more stable multicopter dynamics; reduces flip/crash. -->
    <physics name="2ms" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 0 25 0 1.5708 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>orthographic</projection_type>
      </camera>
    </gui>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <!-- PX4 SITL sensors (IMU / barometer / GPS) require these system plugins. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="start_area_indicator">
      <static>true</static>
      <pose>0 -7 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>20 6 0.02</size></box></geometry>
          <material>
            <ambient>0 0 1 0.9</ambient>
            <diffuse>0 0 1 0.9</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Spawn zone: blue start area (y=-10 to -4, x=-10 to 10). Used by spawn_selector for default spawns. -->
    <model name="spawn_zone">
      <static>true</static>
      <pose>0 -7 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 6</size></plane></geometry>
          <material><ambient>0 0 0 0</ambient><diffuse>0 0 0 0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_n"><static>true</static><pose>0 10 0.75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20.4 0.4 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20.4 0.4 1.5</size></box></geometry><material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -10 0.75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20.4 0.4 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20.4 0.4 1.5</size></box></geometry><material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>10 0 0.75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.4 20.4 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 20.4 1.5</size></box></geometry><material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-10 0 0.75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.4 20.4 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 20.4 1.5</size></box></geometry><material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual></link></model>

    <model name="inner_1_1"><static>true</static><pose>-7.5 6 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="inner_1_2"><static>true</static><pose>-8.75 4 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>2.5 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.5 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <model name="inner_2_1"><static>true</static><pose>-4 8 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>4 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    
    <model name="inner_3_1"><static>true</static><pose>1.5 9 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <model name="inner_4_1"><static>true</static><pose>7.5 6 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 2.5 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 2.5 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="inner_4_2"><static>true</static><pose>8.75 6 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>2.5 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.5 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <model name="inner_5_1"><static>true</static><pose>-5 4 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="inner_5_2"><static>true</static><pose>-3 6 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>4 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <model name="inner_6_1"><static>true</static><pose>-6 0 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>2 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>2 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="inner_6_2"><static>true</static><pose>-5 -2 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="inner_6_3"><static>true</static><pose>-3 -4 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>4 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <model name="inner_7_1"><static>true</static><pose>3 -4 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>4 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="inner_7_2"><static>true</static><pose>5 -2 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <model name="inner_8_1"><static>true</static><pose>3 6 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>4 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="inner_8_2"><static>true</static><pose>5 4 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="inner_8_3"><static>true</static><pose>6 2 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>2 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>2 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="inner_8_4"><static>true</static><pose>7 1 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <!-- unknown_area_boundary_s, unknown_area_boundary_n models commented out -->
    <model name="inner_r_1"><static>true</static><pose>7.5 0 1 0 0 1.57</pose><link name="l"><collision name="c"><geometry><box><size>5 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>5 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <!-- Drones spawned by PX4 SITL via px4_swarm_fast.launch.py -->
  </world>
</sdf>