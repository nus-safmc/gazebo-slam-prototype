<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- PX4-friendly small arena: no embedded rex_quadcopter models. -->
  <!-- Keep world name as "playfield" so /world/playfield/clock matches existing launch defaults. -->
  <world name="playfield">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <!-- PX4 SITL sensors (IMU / barometer / GPS) require these system plugins. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Base field (6 × 6 m) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>6 6</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>6 6</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter walls (2.0 m). The inside faces are at +/-2.8 m. -->
    <model name="perimeter_wall_north">
      <static>true</static>
      <pose>0 3 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>6.6 0.4 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>6.6 0.4 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="perimeter_wall_south">
      <static>true</static>
      <pose>0 -3 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>6.6 0.4 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>6.6 0.4 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="perimeter_wall_east">
      <static>true</static>
      <pose>3 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 6.6 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 6.6 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="perimeter_wall_west">
      <static>true</static>
      <pose>-3 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 6.6 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 6.6 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple interior obstacles (spaced for 4m ToF range + conservative Nav2 clearance). -->
    <model name="block_north">
      <static>true</static>
      <pose>0 1.6 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>2.2 0.45 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>2.2 0.45 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.22 0.22 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_east">
      <static>true</static>
      <pose>2.1 -1.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.45 2.0 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.45 2.0 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.22 0.22 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_west">
      <static>true</static>
      <pose>-2.1 -1.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.55 0.5 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
